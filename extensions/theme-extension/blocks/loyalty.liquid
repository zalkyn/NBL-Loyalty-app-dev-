{% liquid
  assign nbl_config = shop.metafields.app.nbl_config_v1.value
  assign btn_pos = nbl_config.styles.actionButton['Button Position'] | downcase | default: 'left'
  if btn_pos != 'right'
    assign btn_pos = 'left'
  endif

  # Customer config used to live in ONE metafield (nbl_customer_v1). It's
  # now split into four independent metafields — core/transactions/rewards/
  # prizeclaims — written by syncCustomerConfig.js (see that file's
  # module-level comment for why: Shopify's 128KB JSON metafield write
  # limit + avoiding unnecessary rewrites of unrelated data on every event).
  #
  # nbl_customer_v1 (legacy) is read here too, purely as a fallback — a
  # customer who hasn't had any event (or a resync) fire since this rollout
  # still has their old single-blob metafield and nothing in the new ones
  # yet. There's no bulk migration job; main.preact.jsx's
  # mergeCustomerConfig() stitches whichever pieces exist (new, preferred)
  # together with the legacy blob (fallback) into the single `config` shape
  # the rest of the widget already expects.
  assign nbl_customer_legacy = customer.metafields.app.nbl_customer_v1.value
  assign nbl_customer_core = customer.metafields.app.nbl_customer_core_v1.value
  assign nbl_customer_transactions = customer.metafields.app.nbl_customer_transactions_v1.value
  assign nbl_customer_rewards = customer.metafields.app.nbl_customer_rewards_v1.value
  assign nbl_customer_prizeclaims = customer.metafields.app.nbl_customer_prizeclaims_v1.value
  assign nbl_referral_code = nbl_customer_core.referralCode | default: nbl_customer_legacy.referralCode

  # ── Floating widget page visibility ──────────────────────────────────────
  # Customize > Behaviour > "Show widget on" (ConfigPagePickerField.jsx).
  # Only gates THIS block — the app EMBED, target: body, i.e. the floating
  # launcher+panel that would otherwise render on every storefront page.
  # loyalty-page.liquid (the dedicated-page BLOCK a merchant explicitly adds
  # to one page in the theme editor) is a separate, deliberate placement and
  # always renders regardless of this setting.
  #
  # Two independent selectors, OR'd together into a single "matched"
  # boolean, then `mode` decides what "matched" means — see the
  # pageVisibility comment in cssVarsConfig.js for the full shape.
  assign nbl_visibility = nbl_config.styles.widgetConfig.display.pageVisibility
  assign nbl_vis_mode = nbl_visibility.mode | default: 'hideOn'
  assign nbl_vis_pages = nbl_visibility.pages
  assign nbl_vis_types = nbl_visibility.pageTypes

  # Specific-page match — only meaningful on an actual Page resource
  # (page.handle is blank on every other template), matched against the
  # {handle, title} pairs the admin picker stores.
  assign nbl_page_matched = false
  if page.handle != blank
    for nbl_p in nbl_vis_pages
      if nbl_p.handle == page.handle
        assign nbl_page_matched = true
        break
      endif
    endfor
  endif

  # Template-type match — template.name is Shopify's own value ('product',
  # 'collection', 'cart', 'blog', 'article', 'search', ...) EXCEPT the home
  # page, which Liquid calls 'index' but PAGE_TYPE_OPTIONS (cssVarsConfig.js)
  # exposes to merchants as "Home page" / value "home" — translated back
  # here so the two sides still match.
  assign nbl_current_template = template.name
  if nbl_current_template == 'index'
    assign nbl_current_template = 'home'
  endif
  assign nbl_type_matched = false
  for nbl_t in nbl_vis_types
    if nbl_t == nbl_current_template
      assign nbl_type_matched = true
      break
    endif
  endfor

  assign nbl_matched = false
  if nbl_page_matched or nbl_type_matched
    assign nbl_matched = true
  endif

  # hideOn: hide widget WHEN matched. showOnly: hide widget UNLESS matched.
  assign nbl_widget_hidden = false
  if nbl_vis_mode == 'showOnly'
    unless nbl_matched
      assign nbl_widget_hidden = true
    endunless
  elsif nbl_matched
    assign nbl_widget_hidden = true
  endif
%}

{% unless nbl_widget_hidden %}
{%- comment -%}
  Custom font (embed setting "Use a custom font"). Off by default, in which
  case nothing is emitted and the widget keeps inheriting the theme's font.

  The @font-face rules go in the DOCUMENT, not inside the widget's shadow
  root: fonts declared inside a shadow root aren't reliably available to it,
  while document-level @font-face applies to every tree on the page. The
  family itself crosses the shadow boundary as --nbl-font-family (custom
  properties inherit into shadow trees); ui.css's .nbl-custom-font reads it.

  The widget uses weights 300–800, and font_face only declares the one
  variant picked — so every other weight in that range the family actually
  has is declared too (font_modify returns nil for ones it doesn't), letting
  bold/semibold text use real files instead of browser-synthesised bolding.
  Declaring a weight costs nothing until text in that weight renders.
  System fonts have no files; font_face returns an empty string for them.
{%- endcomment -%}
{%- if block.settings.use_custom_font -%}
  {%- assign nbl_font = block.settings.custom_font -%}
  {%- assign nbl_font_weights = '300,400,500,600,700,800' | split: ',' -%}
  {%- style -%}
    {{ nbl_font | font_face: font_display: 'swap' }}
    {%- for nbl_w in nbl_font_weights -%}
      {%- assign nbl_font_variant = nbl_font | font_modify: 'weight', nbl_w -%}
      {%- if nbl_font_variant and nbl_font_variant.weight != nbl_font.weight -%}
        {{ nbl_font_variant | font_face: font_display: 'swap' }}
      {%- endif -%}
    {%- endfor -%}
    :root {
      --nbl-font-family: {{ nbl_font.family }}, {{ nbl_font.fallback_families }};
    }
  {%- endstyle -%}
{%- endif -%}
<script>
  window.NBL_v1 = window.NBL_v1 || {};

  // Read by main.preact.jsx: tags the shadow mount with .nbl-custom-font so
  // the font also reaches buttons/inputs (see ui.css).
  NBL_v1.customFont = {{ block.settings.use_custom_font | json }};

  NBL_v1.appConfig = {{ nbl_config | json }};

  NBL_v1.customer = {
    id:         {{ customer.id         | json }},
    email:      {{ customer.email      | json }},
    name:       {{ customer.name       | json }},
    first_name: {{ customer.first_name | json }},
    last_name:  {{ customer.last_name  | json }},
    configCore:         {{ nbl_customer_core         | json }},
    configTransactions: {{ nbl_customer_transactions | json }},
    configRewards:      {{ nbl_customer_rewards      | json }},
    configPrizeClaims:  {{ nbl_customer_prizeclaims  | json }},
    configLegacy:       {{ nbl_customer_legacy       | json }}
  };

  if (NBL_v1.customer && NBL_v1.customer.configCore && NBL_v1.customer.configCore.points != null) {
    NBL_v1.points = NBL_v1.customer.configCore.points || 0;
  } else if (NBL_v1.customer && NBL_v1.customer.configLegacy && NBL_v1.customer.configLegacy.points != null) {
    NBL_v1.points = NBL_v1.customer.configLegacy.points || 0;
  }

  NBL_v1.routes = {
    account_url:  {{ routes.account_url  | json }},
    login_url:    {{ routes.login_url    | json }},
    logout_url:   {{ routes.logout_url   | json }},
    register_url: {{ routes.register_url | json }}
  };

  NBL_v1.liquidData = {
    isLoggedIn:     {{ customer | json | default: 'null' }} !== null,
    customerName:   {{ customer.name | json | default: '""' }},
    shopUrl:        {{ shop.url | json }},
    referralCode:   {{ nbl_referral_code | json | default: '""' }},
    headerLabel:    {{ nbl_config.styles.header.Heading.Label | json | default: '"Welcome, [name]"' }},
    pointsLabel:    {{ nbl_config.styles.header.Points.Label  | json | default: '"[points] points"' }},
    buttonPosition: {{ btn_pos | json }}
  };

  NBL_v1.tab      = NBL_v1.tab      || {};
  NBL_v1.uiRender = NBL_v1.uiRender || {};

  // App Proxy path for live/fresh data (e.g. re-checking points after an
  // action). shopify.app.toml: [app_proxy] prefix="apps" subpath="widget".
  NBL_v1.proxyPath = "/apps/widget";
</script>

<script src="{{ 'nbl-loyalty-ui.min.js' | asset_url }}" defer></script>
{% endunless %}

{% schema %}
{
  "name": "NB Loyalty",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "checkbox",
      "id": "use_custom_font",
      "label": "Use a custom font",
      "default": false,
      "info": "Off: the widget uses your theme's font. On: the font below is used across the floating widget and the Loyalty & Rewards page block."
    },
    {
      "type": "font_picker",
      "id": "custom_font",
      "label": "Font",
      "default": "inter_n4",
      "info": "Only used when 'Use a custom font' is on."
    }
  ]
}
{% endschema %}
